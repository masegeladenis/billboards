Options -MultiViews
RewriteEngine On
RewriteBase /announcement/public/

# Serve existing files/directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Strip .php — redirect /page.php to /page
RewriteCond %{THE_REQUEST} \s/+announcement/public/([^.]+)\.php[\s?] [NC]
RewriteRule ^ /announcement/public/%1 [R=301,L]

# Add .php internally for extensionless requests
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]
