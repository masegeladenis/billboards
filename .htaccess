<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block dotfiles
    RewriteRule "^\." - [F]

    # Redirect bare root to public/
    RewriteRule ^$ public/ [R=302,L]

    # Pass through real files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
