<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve extensionless URLs from the matching .php file (e.g. /public/display -> /public/display.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>
