<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /announcement/
    
    # Prevent access to hidden files and directories
    RewriteRule "^\." - [F]
    
    # Allow access to public directory
    RewriteCond %{REQUEST_URI} ^/announcement/public/ [OR]
    RewriteCond %{REQUEST_URI} ^/announcement/api/ [OR]
    RewriteCond %{REQUEST_URI} ^/announcement/uploads/
    RewriteRule ^ - [L]
</IfModule>
